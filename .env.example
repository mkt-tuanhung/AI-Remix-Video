# ─────────────────────────────────────────────────────────────
# AI Remix Video — biến môi trường
# Sao chép file này thành .env.local và điền key khi cần.
# KHÔNG key nào là bắt buộc: thiếu key nào, hệ thống tự chạy MOCK cho phần đó.
# ─────────────────────────────────────────────────────────────

# --- Lưu trữ dữ liệu ---
# "fs"       = lưu ra thư mục .data/ (mặc định, chạy ngay không cần cài gì)
# "supabase" = dùng Supabase (cần 2 biến bên dưới + chạy supabase/schema.sql)
STORE_DRIVER=fs

# Mật khẩu chung khi chia sẻ link (bỏ trống = không cần đăng nhập).
# Đặt giá trị này rồi ai mở app cũng phải nhập đúng mới dùng được.
# APP_PASSWORD=doi-mat-khau-cua-ban

# Prod (Render/Railway): trỏ tới ổ đĩa BỀN để không mất dữ liệu khi redeploy.
# Để trống ở local (dữ liệu vào .data/ và public/uploads/).
# STORAGE_DIR=/app/persistent

# --- Supabase (chỉ dùng khi STORE_DRIVER=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI: transcribe (Whisper) + vision (gpt-4o) + viết kịch bản ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# --- Text-to-Speech ---
# TTS_PROVIDER: "openai" | "elevenlabs" | "mock"
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=tts-1
ELEVENLABS_API_KEY=

# --- Stock media (B-roll / ảnh minh hoạ có giấy phép rõ ràng) ---
# STOCK_PROVIDER: "pexels" | "pixabay" | "mock"
STOCK_PROVIDER=pexels
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Video chuyển động (image-to-video) cho module Truyện → Phim ---
# Lấy key ở fal.ai/dashboard/keys. Thiếu key → ảnh động Ken Burns (miễn phí).
FAL_KEY=
# Model image-to-video (mặc định LTX rẻ). Có thể đổi sang model khác trên fal.
FAL_VIDEO_MODEL=fal-ai/ltx-video-13b-distilled/image-to-video

# --- Freepik AI API (gom nhiều model video: Kling/Veo/MiniMax/PixVerse/LTX...) ---
# Ưu tiên dùng Freepik nếu có key này (thay cho fal). Lấy key ở freepik.com → API.
FREEPIK_API_KEY=
# slug model image-to-video (đổi theo gói/credit): kling-v2-1-master, minimax-hailuo-02-768p,
# pixverse-v5, ltx-video-v097, seedance-pro-1080p...
FREEPIK_VIDEO_MODEL=kling-v2-1-master

# --- Media / render ---
# Đường dẫn ffmpeg/ffprobe nếu không nằm trong PATH. Thiếu ffmpeg => ingest/vision chạy mock.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
